index 0000000..4b7fa87
--- /dev/null
+++ b/Tests/UnitTests/Core/Services/DlqReplayRedactedHeaderTests.cs
@@ -0,0 +1,124 @@
+using System.Text;
+using FlySwattr.NATS.Abstractions;
+using FlySwattr.NATS.Core;
+using FlySwattr.NATS.Core.Configuration;
+using FlySwattr.NATS.Core.Services;
+using Microsoft.Extensions.Logging;
+using Microsoft.Extensions.Options;
+using NSubstitute;
+using Shouldly;
+using TUnit.Core;
+
+namespace UnitTests.Core.Services;
+
+/// <summary>
+/// DlqHeaderRedactionOptions (enabled by default) replaces stored header VALUES with a
+/// redaction marker. Replay must not republish those markers as live header values —
+/// previously a replayed message carried e.g. X-Tenant: "[REDACTED]".
+/// </summary>
+[Property("nTag", "Core")]
+public class DlqReplayRedactedHeaderTests
+{
+    [Test]
+    public async Task ReplayAsync_DropsRedactedHeaderValues_KeepsRealOnes()
+    {
+        var dlqStore = Substitute.For<IDlqStore>();
+        var publisher = Substitute.For<IJetStreamPublisher>();
+        var serializer = Substitute.For<IMessageSerializer>();
+        var aliasRegistry = new MessageTypeAliasRegistry(
+            Options.Create(new MessageTypeAliasOptions { RequireExplicitAliases = false }));
+
+        var sut = new NatsDlqRemediationService(
+            dlqStore,
+            publisher,
+            serializer,
+            aliasRegistry,
+            Substitute.For<ILogger<NatsDlqRemediationService>>(),
+            headerRedactionOptions: Options.Create(new DlqHeaderRedactionOptions()));
+
+        var entryId = "STREAM.consumer.1";
+        var entry = new DlqMessageEntry
+        {
+            Id = entryId,
+            OriginalStream = "STREAM",
+            OriginalConsumer = "consumer",
+            OriginalSubject = "orders.created",
+            OriginalSequence = 1,
+            DeliveryCount = 5,
+            StoredAt = DateTimeOffset.UtcNow,
+            Payload = Encoding.UTF8.GetBytes("payload"),
+            OriginalHeaders = new Dictionary<string, string>
+            {
+                ["X-Tenant"] = "[REDACTED]",        // redacted by DefaultDlqPoisonHandler
+                ["X-Correlation-Id"] = "abc-123"    // allow-listed, real value survived
+            }
+        };
+
+        dlqStore.GetAsync(entryId, Arg.Any<CancellationToken>()).Returns(entry);
+        dlqStore.UpdateStatusAsync(entryId, Arg.Any<DlqMessageStatus>(), Arg.Any<ulong?>(), Arg.Any<CancellationToken>())
+            .Returns(new DlqEntryUpdateResult(DlqEntryUpdateOutcome.Updated, 2));
+
+        MessageHeaders? publishedHeaders = null;
+        publisher.PublishAsync(
+                Arg.Any<string>(), Arg.Any<byte[]>(), Arg.Any<string?>(),
+                Arg.Do<MessageHeaders?>(h => publishedHeaders = h), Arg.Any<CancellationToken>())
+            .Returns(Task.CompletedTask);
+
+        var result = await sut.ReplayAsync(entryId);
+
+        result.Success.ShouldBeTrue();
+        publishedHeaders.ShouldNotBeNull();
+        publishedHeaders!.Headers.ShouldContainKeyAndValue("X-Correlation-Id", "abc-123");
+        publishedHeaders.Headers.ShouldNotContainKey("X-Tenant");
+        publishedHeaders.Headers.Values.ShouldNotContain("[REDACTED]");
+    }
+
+    [Test]
+    public async Task ReplayAsync_AllHeadersRedacted_PublishesWithoutHeaders()
+    {
+        var dlqStore = Substitute.For<IDlqStore>();
+        var publisher = Substitute.For<IJetStreamPublisher>();
+        var serializer = Substitute.For<IMessageSerializer>();
+        var aliasRegistry = new MessageTypeAliasRegistry(
+            Options.Create(new MessageTypeAliasOptions { RequireExplicitAliases = false }));
+
+        var sut = new NatsDlqRemediationService(
+            dlqStore,
+            publisher,
+            serializer,
+            aliasRegistry,
+            Substitute.For<ILogger<NatsDlqRemediationService>>());
+
+        var entryId = "STREAM.consumer.2";
+        var entry = new DlqMessageEntry
+        {
+            Id = entryId,
+            OriginalStream = "STREAM",
+            OriginalConsumer = "consumer",
+            OriginalSubject = "orders.created",
+            OriginalSequence = 2,
+            DeliveryCount = 5,
+            StoredAt = DateTimeOffset.UtcNow,
+            Payload = Encoding.UTF8.GetBytes("payload"),
+            OriginalHeaders = new Dictionary<string, string>
+            {
+                ["X-Tenant"] = "[REDACTED]",
+                ["X-Session"] = "[REDACTED]"
+            }
+        };
+
+        dlqStore.GetAsync(entryId, Arg.Any<CancellationToken>()).Returns(entry);
+        dlqStore.UpdateStatusAsync(entryId, Arg.Any<DlqMessageStatus>(), Arg.Any<ulong?>(), Arg.Any<CancellationToken>())
+            .Returns(new DlqEntryUpdateResult(DlqEntryUpdateOutcome.Updated, 2));
+
+        var result = await sut.ReplayAsync(entryId);
+
+        result.Success.ShouldBeTrue();
+        await publisher.Received(1).PublishAsync(
+            "orders.created",
+            Arg.Any<byte[]>(),
+            Arg.Any<string?>(),
+            Arg.Is<MessageHeaders?>(h => h == null),
+            Arg.Any<CancellationToken>());
+    }
+}
