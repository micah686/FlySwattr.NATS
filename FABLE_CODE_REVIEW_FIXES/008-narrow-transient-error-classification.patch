diff --git a/FlySwattr.NATS.Resilience/Decorators/ResilientJetStreamPublisher.cs b/FlySwattr.NATS.Resilience/Decorators/ResilientJetStreamPublisher.cs
index 94bf894..f83004d 100644
--- a/FlySwattr.NATS.Resilience/Decorators/ResilientJetStreamPublisher.cs
+++ b/FlySwattr.NATS.Resilience/Decorators/ResilientJetStreamPublisher.cs
@@ -107,11 +107,30 @@ internal class ResilientJetStreamPublisher : IJetStreamPublisher
 
     private static bool IsOperationCanceled(Exception ex) => ex is OperationCanceledException;
 
-    private static bool IsTransient(Exception ex) =>
-        ex is TimeoutException
+    private static bool IsTransient(Exception ex)
+    {
+        // JS API errors: only service-availability codes are transient.
+        // 503 = Service Unavailable, 504 = Gateway Timeout. This check must run
+        // before the NatsException fallback below (NatsJSApiException derives from
+        // NatsException), otherwise permanent 400-class API errors are retried.
+        if (ex is NatsJSApiException jsApi)
+            return jsApi.Error.Code is 503 or 504;
+
+        // Publish-ack/API timeouts and connection drops are retryable. Retrying a
+        // publish whose ack was lost is safe: the message ID makes it idempotent.
+        if (ex is NatsJSPublishNoResponseException or NatsJSApiNoResponseException
+            or NatsJSTimeoutException or NatsJSConnectionException)
+            return true;
+
+        // Remaining JetStream-layer domain errors (protocol violations, duplicates,
+        // not-found) are permanent.
+        if (ex is NatsJSException)
+            return false;
+
+        return ex is TimeoutException
             or IOException
             or SocketException
             or NatsNoRespondersException
-            or NatsException
-        || (ex is NatsJSApiException jsApi && jsApi.Error.Code is 503 or 504);
+            or NatsException;
+    }
 }
