diff --git a/Tests/UnitTests/Core/Stores/TransientErrorClassificationTests.cs b/Tests/UnitTests/Core/Stores/TransientErrorClassificationTests.cs
new file mode 100644
index 0000000..9898f7d
--- /dev/null
+++ b/Tests/UnitTests/Core/Stores/TransientErrorClassificationTests.cs
@@ -0,0 +1,107 @@
+using FlySwattr.NATS.Abstractions;
+using FlySwattr.NATS.Core.Stores;
+using FlySwattr.NATS.Resilience.Builders;
+using FlySwattr.NATS.Resilience.Decorators;
+using Microsoft.Extensions.Logging;
+using Microsoft.Extensions.Logging.Abstractions;
+using NATS.Client.JetStream.Models;
+using NATS.Client.JetStream;
+using NATS.Client.ObjectStore;
+using NATS.Client.ObjectStore.Models;
+using NSubstitute;
+using Shouldly;
+using TUnit.Core;
+
+namespace UnitTests.Core.Stores;
+
+/// <summary>
+/// Permanent errors must not be retried. NatsObjNotFoundException and 400-class
+/// NatsJSApiException derive from NatsException, so a naive "is NatsException"
+/// transient check retried them with backoff (a missing claim-check object cost
+/// ~6 seconds of retries per hydration attempt; permanently failing publishes
+/// burned 3 retries before surfacing).
+/// </summary>
+[Property("nTag", "Core")]
+public class TransientErrorClassificationTests
+{
+    [Test]
+    public async Task ObjectStore_GetAsync_MissingObject_IsNotRetried()
+    {
+        var objContext = Substitute.For<INatsObjContext>();
+        var objStore = Substitute.For<INatsObjStore>();
+        objContext.GetObjectStoreAsync("bucket", Arg.Any<CancellationToken>()).Returns(objStore);
+
+        var calls = 0;
+        objStore.GetAsync("missing-key", Arg.Any<Stream>(), Arg.Any<bool>(), Arg.Any<CancellationToken>())
+            .Returns(_ =>
+            {
+                calls++;
+                return ValueTask.FromException<ObjectMetadata>(new NatsObjNotFoundException("Object not found"));
+            });
+
+        var sut = new NatsObjectStore(objContext, "bucket", Substitute.For<ILogger<NatsObjectStore>>());
+
+        using var target = new MemoryStream();
+        await Should.ThrowAsync<NatsObjNotFoundException>(() => sut.GetAsync("missing-key", target));
+
+        calls.ShouldBe(1); // NotFound is permanent: a single attempt, no backoff retries
+        await sut.DisposeAsync();
+    }
+
+    [Test]
+    public async Task Publisher_PermanentJsApiError_IsNotRetried()
+    {
+        var inner = Substitute.For<IJetStreamPublisher>();
+        var calls = 0;
+        inner.PublishAsync(
+                Arg.Any<string>(), Arg.Any<string>(), Arg.Any<string?>(),
+                Arg.Any<MessageHeaders?>(), Arg.Any<CancellationToken>())
+            .Returns(_ =>
+            {
+                calls++;
+                return Task.FromException(new NatsJSApiException(new ApiError { Code = 400, Description = "bad request" }));
+            });
+
+        var sut = new ResilientJetStreamPublisher(
+            inner,
+            new HierarchicalResilienceBuilder(NullLogger<HierarchicalResilienceBuilder>.Instance),
+            NullLogger<ResilientJetStreamPublisher>.Instance);
+
+        await Should.ThrowAsync<NatsJSApiException>(
+            () => sut.PublishAsync("orders.created", "payload", "Order-1-Created"));
+
+        calls.ShouldBe(1); // 400-class API errors are permanent: no retries
+    }
+
+    [Test]
+    public async Task Publisher_ServiceUnavailable_IsRetried()
+    {
+        var inner = Substitute.For<IJetStreamPublisher>();
+        var calls = 0;
+        inner.PublishAsync(
+                Arg.Any<string>(), Arg.Any<string>(), Arg.Any<string?>(),
+                Arg.Any<MessageHeaders?>(), Arg.Any<CancellationToken>())
+            .Returns(_ =>
+            {
+                calls++;
+                return Task.FromException(new NatsJSApiException(new ApiError { Code = 503, Description = "unavailable" }));
+            });
+
+        var sut = new ResilientJetStreamPublisher(
+            inner,
+            new HierarchicalResilienceBuilder(NullLogger<HierarchicalResilienceBuilder>.Instance),
+            NullLogger<ResilientJetStreamPublisher>.Instance,
+            new Polly.Retry.RetryStrategyOptions
+            {
+                MaxRetryAttempts = 2,
+                Delay = TimeSpan.FromMilliseconds(1),
+                UseJitter = false,
+                ShouldHandle = new Polly.PredicateBuilder().Handle<NatsJSApiException>(e => e.Error.Code is 503 or 504)
+            });
+
+        await Should.ThrowAsync<NatsJSApiException>(
+            () => sut.PublishAsync("orders.created", "payload", "Order-1-Created"));
+
+        calls.ShouldBe(3); // initial + 2 retries with the same message ID (idempotent)
+    }
+}
