diff --git a/Tests/UnitTests/Resilience/ResilientConsumerSemaphoreLifetimeTests.cs b/Tests/UnitTests/Resilience/ResilientConsumerSemaphoreLifetimeTests.cs
new file mode 100644
index 0000000..106f868
--- /dev/null
+++ b/Tests/UnitTests/Resilience/ResilientConsumerSemaphoreLifetimeTests.cs
@@ -0,0 +1,94 @@
+using FlySwattr.NATS.Abstractions;
+using FlySwattr.NATS.Resilience.Builders;
+using FlySwattr.NATS.Resilience.Configuration;
+using FlySwattr.NATS.Resilience.Decorators;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using NSubstitute;
+using Shouldly;
+using TUnit.Core;
+
+namespace UnitTests.Resilience;
+
+/// <summary>
+/// IJetStreamConsumer.ConsumeAsync returns when the background consumer has STARTED, not
+/// when it stops. The resilient decorator previously disposed the per-consumer semaphore in
+/// a finally block right after start, so every message processed afterwards failed with
+/// ObjectDisposedException. These tests pin that the handler wrapper remains usable after
+/// the consume call has returned.
+/// </summary>
+[Property("nTag", "Resilience")]
+public class ResilientConsumerSemaphoreLifetimeTests
+{
+    private static ResilientJetStreamConsumer CreateSut(IJetStreamConsumer inner)
+    {
+        var bulkheads = new BulkheadManager(
+            Options.Create(new BulkheadConfiguration()),
+            NullLogger<BulkheadManager>.Instance);
+        var semaphores = new ConsumerSemaphoreManager(NullLogger<ConsumerSemaphoreManager>.Instance);
+        var resilience = new HierarchicalResilienceBuilder(NullLogger<HierarchicalResilienceBuilder>.Instance);
+        return new ResilientJetStreamConsumer(
+            inner,
+            bulkheads,
+            semaphores,
+            resilience,
+            NullLogger<ResilientJetStreamConsumer>.Instance);
+    }
+
+    [Test]
+    public async Task ConsumeAsync_WithMaxConcurrency_HandlerStillWorksAfterStartReturns()
+    {
+        Func<IJsMessageContext<string>, Task>? capturedHandler = null;
+        var inner = Substitute.For<IJetStreamConsumer>();
+        // ForAnyArgs + CallInfo capture: Vogen struct arguments (StreamName/SubjectName)
+        // confuse NSubstitute's Arg matchers, so capture the handler from the call info.
+        inner.ConsumeAsync<string>(StreamName.From("any"), SubjectName.From("any"), null!, null, CancellationToken.None)
+            .ReturnsForAnyArgs(ci =>
+            {
+                capturedHandler = ci.Arg<Func<IJsMessageContext<string>, Task>>();
+                return Task.CompletedTask; // background consumer "started"
+            });
+
+        var sut = CreateSut(inner);
+        var handled = 0;
+
+        await sut.ConsumeAsync<string>(
+            StreamName.From("ORDERS"),
+            SubjectName.From("orders.created"),
+            _ => { Interlocked.Increment(ref handled); return Task.CompletedTask; },
+            new JetStreamConsumeOptions { MaxConcurrency = 2 });
+
+        capturedHandler.ShouldNotBeNull();
+
+        // Simulate messages arriving AFTER ConsumeAsync returned (the real-world flow).
+        var context = Substitute.For<IJsMessageContext<string>>();
+        await Should.NotThrowAsync(() => capturedHandler!(context));
+        await Should.NotThrowAsync(() => capturedHandler!(context));
+        handled.ShouldBe(2);
+    }
+
+    [Test]
+    public async Task ConsumePullAsync_WithMaxConcurrency_HandlerStillWorksAfterStartReturns()
+    {
+        Func<IJsMessageContext<string>, Task>? capturedHandler = null;
+        var inner = Substitute.For<IJetStreamConsumer>();
+        inner.ConsumePullAsync<string>(StreamName.From("any"), ConsumerName.From("any"), null!, null, CancellationToken.None)
+            .ReturnsForAnyArgs(ci =>
+            {
+                capturedHandler = ci.Arg<Func<IJsMessageContext<string>, Task>>();
+                return Task.CompletedTask;
+            });
+
+        var sut = CreateSut(inner);
+
+        await sut.ConsumePullAsync<string>(
+            StreamName.From("ORDERS"),
+            ConsumerName.From("orders-processor"),
+            _ => Task.CompletedTask,
+            new JetStreamConsumeOptions { MaxConcurrency = 1 });
+
+        capturedHandler.ShouldNotBeNull();
+        var context = Substitute.For<IJsMessageContext<string>>();
+        await Should.NotThrowAsync(() => capturedHandler!(context));
+    }
+}
