+using FlySwattr.NATS.Core.Stores;
+using Microsoft.Extensions.Logging;
+using NATS.Client.ObjectStore;
+using NATS.Client.ObjectStore.Models;
+using NSubstitute;
+using Shouldly;
+using TUnit.Core;
+
+namespace UnitTests.Core.Stores;
+
+/// <summary>
+/// Retrying a Put with a non-seekable stream re-uploads only the bytes remaining after the
+/// failed attempt — the object is then stored with silently truncated content and PutAsync
+/// reports success. Non-seekable uploads must therefore never be retried.
+/// </summary>
+[Property("nTag", "Core")]
+public class NonSeekablePutRetryTests
+{
+    private sealed class NonSeekableStream : MemoryStream
+    {
+        public NonSeekableStream(byte[] data) : base(data) { }
+        public override bool CanSeek => false;
+    }
+
+    [Test]
+    public async Task PutAsync_NonSeekableStream_TransientFailure_IsNotRetried()
+    {
+        var objContext = Substitute.For<INatsObjContext>();
+        var objStore = Substitute.For<INatsObjStore>();
+        objContext.GetObjectStoreAsync("bucket", Arg.Any<CancellationToken>()).Returns(objStore);
+
+        var calls = 0;
+        objStore.PutAsync(Arg.Any<string>(), Arg.Any<Stream>(), leaveOpen: true, cancellationToken: Arg.Any<CancellationToken>())
+            .Returns(_ =>
+            {
+                calls++;
+                // Simulate a network failure after part of the stream was consumed.
+                return ValueTask.FromException<ObjectMetadata>(new TimeoutException("connection dropped mid-upload"));
+            });
+
+        var sut = new NatsObjectStore(objContext, "bucket", Substitute.For<ILogger<NatsObjectStore>>());
+        await using var data = new NonSeekableStream([1, 2, 3, 4]);
+
+        await Should.ThrowAsync<TimeoutException>(() => sut.PutAsync("key", data));
+
+        // Exactly one attempt: a retry would silently upload truncated content.
+        calls.ShouldBe(1);
+        await sut.DisposeAsync();
+    }
+
+    [Test]
+    public async Task PutAsync_SeekableStream_TransientFailure_IsStillRetried()
+    {
+        var objContext = Substitute.For<INatsObjContext>();
+        var objStore = Substitute.For<INatsObjStore>();
+        objContext.GetObjectStoreAsync("bucket", Arg.Any<CancellationToken>()).Returns(objStore);
+
+        var calls = 0;
+        objStore.PutAsync(Arg.Any<string>(), Arg.Any<Stream>(), leaveOpen: true, cancellationToken: Arg.Any<CancellationToken>())
+            .Returns(callInfo =>
+            {
+                calls++;
+                if (calls == 1)
+                {
+                    return ValueTask.FromException<ObjectMetadata>(new TimeoutException("transient"));
+                }
+
+                // Retry must observe a rewound stream.
+                var stream = callInfo.Arg<Stream>();
+                stream.Position.ShouldBe(0);
+                return ValueTask.FromResult(new ObjectMetadata { Bucket = "bucket", Name = "key" });
+            });
+
+        var sut = new NatsObjectStore(objContext, "bucket", Substitute.For<ILogger<NatsObjectStore>>());
+        using var data = new MemoryStream([1, 2, 3, 4]);
+        data.Position = 4; // pretend a previous consumer moved it
+
+        var name = await sut.PutAsync("key", data);
+
+        name.ShouldBe("key");
+        calls.ShouldBe(2);
+        await sut.DisposeAsync();
+    }
+}
