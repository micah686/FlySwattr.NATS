index 0000000..a3a61aa
--- /dev/null
+++ b/Tests/UnitTests/Hosting/OffloadingConfiguredGateTests.cs
@@ -0,0 +1,47 @@
+using FlySwattr.NATS.Abstractions;
+using FlySwattr.NATS.Core.Configuration;
+using FlySwattr.NATS.Hosting.Extensions;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Options;
+using Shouldly;
+using TUnit.Core;
+
+namespace UnitTests.Hosting;
+
+/// <summary>
+/// The consumer hosted services must treat payload offloading as "configured" only when
+/// AddPayloadOffloading actually ran (marker present). IOptions&lt;PayloadOffloadingOptions&gt;
+/// is resolvable in any host with the options infrastructure, so options-presence is not a
+/// valid feature gate — using it forced every modular (non-offloading) host to register an
+/// IObjectStore or fail at startup.
+/// </summary>
+[Property("nTag", "Hosting")]
+public class OffloadingConfiguredGateTests
+{
+    [Test]
+    public void WithoutAddPayloadOffloading_GateIsClosed_EvenThoughOptionsResolve()
+    {
+        var services = new ServiceCollection();
+        services.AddOptions();
+
+        using var sp = services.BuildServiceProvider();
+
+        // The trap this guards against: options always resolve...
+        sp.GetService<IOptions<PayloadOffloadingOptions>>().ShouldNotBeNull();
+
+        // ...but offloading is NOT configured.
+        ServiceCollectionExtensions.IsPayloadOffloadingConfigured(sp).ShouldBeFalse();
+    }
+
+    [Test]
+    public void WithOffloadingMarker_GateIsOpen()
+    {
+        var services = new ServiceCollection();
+        services.AddOptions();
+        services.AddSingleton<NatsPayloadOffloadingMarker>();
+
+        using var sp = services.BuildServiceProvider();
+
+        ServiceCollectionExtensions.IsPayloadOffloadingConfigured(sp).ShouldBeTrue();
+    }
+}
