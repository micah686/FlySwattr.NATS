diff --git a/Tests/UnitTests/Hosting/Services/JsMessageContextReplySemanticsTests.cs b/Tests/UnitTests/Hosting/Services/JsMessageContextReplySemanticsTests.cs
new file mode 100644
index 0000000..eb1ed76
--- /dev/null
+++ b/Tests/UnitTests/Hosting/Services/JsMessageContextReplySemanticsTests.cs
@@ -0,0 +1,80 @@
+using FlySwattr.NATS.Core;
+using FlySwattr.NATS.Hosting.Services;
+using NATS.Client.JetStream;
+using NSubstitute;
+using Shouldly;
+using TUnit.Core;
+
+namespace UnitTests.Hosting.Services;
+
+/// <summary>
+/// JetStream deliveries carry the ack inbox ($JS.ACK.…) as the protocol-level reply subject.
+/// These tests pin the contract that the ack subject is never exposed as an application
+/// ReplyTo and that RespondAsync fails loudly instead of replying onto the ack subject.
+/// (NatsJSMsg&lt;T&gt; does not implement INatsMsg&lt;T&gt;, so the previous cast-based reply
+/// path could never succeed against a real server.)
+/// </summary>
+[Property("nTag", "Hosting")]
+public class JsMessageContextReplySemanticsTests
+{
+    private const string AckSubject = "$JS.ACK.ORDERS.orders-processor.1.7.7.1700000000000000000.0";
+
+    private static INatsJSMsg<string> CreateMsg(string? replyTo)
+    {
+        var msg = Substitute.For<INatsJSMsg<string>>();
+        msg.Subject.Returns("orders.created");
+        msg.Data.Returns("payload");
+        msg.ReplyTo.Returns(replyTo);
+        return msg;
+    }
+
+    [Test]
+    public void HostingWrapper_ReplyTo_AckSubject_IsReportedAsNull()
+    {
+        var context = new JsMessageContextWrapper<string>(CreateMsg(AckSubject));
+
+        context.ReplyTo.ShouldBeNull();
+    }
+
+    [Test]
+    public void HostingWrapper_ReplyTo_NonAckSubject_IsPassedThrough()
+    {
+        var context = new JsMessageContextWrapper<string>(CreateMsg("_INBOX.abc123"));
+
+        context.ReplyTo.ShouldBe("_INBOX.abc123");
+    }
+
+    [Test]
+    public void HostingWrapper_ReplyTo_Null_IsReportedAsNull()
+    {
+        var context = new JsMessageContextWrapper<string>(CreateMsg(null));
+
+        context.ReplyTo.ShouldBeNull();
+    }
+
+    [Test]
+    public async Task HostingWrapper_RespondAsync_AlwaysThrowsNotSupported()
+    {
+        var context = new JsMessageContextWrapper<string>(CreateMsg(AckSubject));
+
+        await Should.ThrowAsync<NotSupportedException>(
+            () => context.RespondAsync("response"));
+    }
+
+    [Test]
+    public void CoreContext_ReplyTo_AckSubject_IsReportedAsNull()
+    {
+        var context = new JsMessageContext<string>(CreateMsg(AckSubject));
+
+        context.ReplyTo.ShouldBeNull();
+    }
+
+    [Test]
+    public async Task CoreContext_RespondAsync_AlwaysThrowsNotSupported()
+    {
+        var context = new JsMessageContext<string>(CreateMsg("_INBOX.abc123"));
+
+        await Should.ThrowAsync<NotSupportedException>(
+            () => context.RespondAsync("response"));
+    }
+}
