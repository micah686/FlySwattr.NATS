+using System.Reflection;
+using FlySwattr.NATS.Abstractions;
+using FlySwattr.NATS.Core.Services;
+using FlySwattr.NATS.Extensions;
+using Microsoft.Extensions.DependencyInjection;
+using Shouldly;
+using TUnit.Core;
+
+namespace UnitTests.DI;
+
+/// <summary>
+/// <c>DefaultDlqPoisonHandler</c> offloads oversized DLQ payloads through the keyed
+/// claim-check object store. The remediation service must resolve the same store, or
+/// replay of offloaded payloads always fails with "Unable to retrieve payload for replay".
+/// (The library never registers an unkeyed IObjectStore, so a plain
+/// GetService&lt;IObjectStore&gt;() resolution yields null.)
+/// </summary>
+[Property("nTag", "DI")]
+public class DlqRemediationObjectStoreResolutionTests
+{
+    [Test]
+    public async Task GoldenPath_DlqRemediationService_ResolvesClaimCheckObjectStore()
+    {
+        var services = new ServiceCollection();
+        services.AddLogging();
+        services.AddEnterpriseNATSMessaging(opts =>
+        {
+            opts.Core.Url = "nats://localhost:4222";
+        });
+
+        await using var sp = services.BuildServiceProvider();
+        var remediation = sp.GetRequiredService<IDlqRemediationService>();
+
+        remediation.ShouldBeOfType<NatsDlqRemediationService>();
+        var objectStoreField = typeof(NatsDlqRemediationService)
+            .GetField("_objectStore", BindingFlags.Instance | BindingFlags.NonPublic);
+        objectStoreField.ShouldNotBeNull();
+        objectStoreField.GetValue(remediation).ShouldNotBeNull(
+            "remediation must use the same (keyed) object store the poison handler offloads to");
+    }
+}
