+    /// <summary>
+    /// Resolves the object store used for offloaded DLQ payloads. <c>DefaultDlqPoisonHandler</c>
+    /// offloads oversized payloads through the claim-check store, which is registered as a
+    /// <em>keyed</em> service (the key is carried in <see cref="PayloadOffloadingOptions.ObjectStoreServiceKey"/>).
+    /// The remediation service must resolve the same store, otherwise replay of offloaded
+    /// payloads fails with "Unable to retrieve payload for replay".
+    /// </summary>
+    private static IObjectStore? ResolveDlqObjectStore(IServiceProvider sp)
+    {
+        var offloadKey = sp.GetService<IOptions<PayloadOffloadingOptions>>()?.Value.ObjectStoreServiceKey;
+        if (offloadKey != null)
+        {
+            var keyed = sp.GetKeyedService<IObjectStore>(offloadKey);
+            if (keyed != null)
+            {
+                return keyed;
+            }
+        }
+
+        return sp.GetService<IObjectStore>();
+    }
